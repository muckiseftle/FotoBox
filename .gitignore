/target
**/*.rs.bk
Cargo.lock.orig

# Runtime data (database, captured photos)
/data
/var

# Frontend
/frontend/node_modules
/frontend/dist

# Built frontend assets are embedded at compile time; keep only a placeholder
# so a fresh clone still compiles before `npm run build` is run.
/crates/snap-web/assets/*
!/crates/snap-web/assets/.gitkeep

# Packaging / build output
/dist
/stage
/installer/windows/Output

# Editor / local preview config (machine-specific paths)
/.claude

# Env / secrets
.env
*.local

# Local preview/test data
preview-data/

# Icon generator's local npm install (the generated icon.* files ARE committed)
/branding/node_modules
/branding/package.json
/branding/package-lock.json

# Local update-test scratch dirs
tmp-update-test/
tmp-zipcheck/
